# Puerto serie del Arduino. En Windows es COMx, en Linux /dev/ttyACM0 o /dev/ttyUSB0.
# Para averiguarlo: npm run puertos
PUERTO_SERIE=COM4
BAUDIOS=115200

# La API tiene que estar levantada (cd api && npm run dev)
API_URL=http://localhost:3000

# Token EN CLARO del dispositivo de tipo gateway. En la base vive solo su hash.
TOKEN_DISPOSITIVO=pegar-aca-el-token-en-claro

# Confianza que se declara en el cuerpo de POST /api/eventos (README 5).
# Vive aca y no en el sketch porque es un campo de la API, y el Arduino no
# sabe que existe una API.
CONFIANZA_SENSOR=0.8