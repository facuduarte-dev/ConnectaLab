# Copia este archivo a ".env" (sin ".example") y completa los valores reales.
# El .env NUNCA se sube a GitHub (ya esta listado en .gitignore).

# Project URL de tu proyecto en Supabase (Project Settings -> General -> Project ID
# te da el "wudfiaqlltjrfasiwnnp"; la URL completa es https://<ese-id>.supabase.co)
SUPABASE_URL=https://tu-project-id.supabase.co

# Secret key de Supabase (Project Settings -> API Keys -> Secret key, empieza con sb_secret_...)
# Bypassa Row Level Security. Solo se usa en el backend. Nunca en el frontend, nunca en el firmware.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxxx

# Puerto donde arranca el servidor local
PORT=3000

# Origen permitido para pedidos del frontend (CORS). En desarrollo, el puerto
# donde corre tu web local (Vite/React suele usar 5173 o 3000; ajustalo si difiere).
CORS_ORIGIN=http://localhost:5173
